PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hargeisa_tax_db

# mysqldump/mysql CLI paths, used for backup & restore. In Docker/production these
# are just "mysqldump"/"mysql" (on PATH in the official mysql/mariadb images). On
# Windows with XAMPP, point these at C:\xampp\mysql\bin\mysqldump.exe / mysql.exe.
MYSQLDUMP_BIN=mysqldump
MYSQL_BIN=mysql

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
COOKIE_NAME=htax_token

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_EMAIL=admin@hargeisatax.gov.so
SEED_ADMIN_FULL_NAME=System Administrator
