# Copy to ".env" in the repo root before running `docker compose up`.
# docker-compose.yml reads these to configure the db/server containers.

DB_NAME=hargeisa_tax_db
DB_PASSWORD=change-this-strong-password

JWT_SECRET=replace-with-a-long-random-string

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_EMAIL=admin@hargeisatax.gov.so
SEED_ADMIN_FULL_NAME=System Administrator

# Public URL the frontend is served from (used for CORS on the server).
CLIENT_URL=http://localhost
